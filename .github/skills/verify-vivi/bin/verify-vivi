            usage >&2
            exit 2
        }
        chat_implicit "$2"
        ;;
    chat-attachments)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_attachments "$2"
        ;;
    chat-async-bash)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_async_bash "$2"
        ;;
    chat-markdown)
