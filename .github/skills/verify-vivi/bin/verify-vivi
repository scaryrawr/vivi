#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
artifact_root="$repo_root/.verify/vivi"
binary="$repo_root/zig-out/bin/vivi"

usage() {
    cat <<'EOF'
Usage:
  verify-vivi doctor
  verify-vivi cli-discovery <run-id>
  verify-vivi chat-streaming <run-id>
  verify-vivi chat-streaming-input <run-id>
  verify-vivi chat-markdown <run-id>
  verify-vivi chat-markdown-read <run-id>
  verify-vivi chat-ask-user <run-id>
  verify-vivi chat-model-menu <run-id>
  verify-vivi chat-customization <run-id>
  verify-vivi chat-session-resume <run-id>
  verify-vivi chat-shutdown <run-id>
  verify-vivi extract-frames <run-id> <chat-streaming|chat-streaming-input|chat-markdown|chat-markdown-read|chat-ask-user|chat-model-menu|chat-customization|chat-session-resume|chat-shutdown>
  verify-vivi frame-check <run-id> <chat-streaming|chat-streaming-input|chat-markdown|chat-markdown-read|chat-ask-user|chat-model-menu|chat-customization|chat-session-resume|chat-shutdown>
  verify-vivi cleanup <run-id>
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'missing required command: %s\n' "$1" >&2
        exit 1
    }
}

validate_run_id() {
    case "${1:-}" in
        ""|*[!A-Za-z0-9._-]*)
            printf 'run-id must use only letters, digits, dots, underscores, or hyphens\n' >&2
            exit 1
            ;;
    esac
}

prepare_run() {
    run_id=$1
    validate_run_id "$run_id"
    run_dir="$artifact_root/$run_id"
    mkdir -p "$run_dir"
    printf '%s\n' "$run_dir"
}

build_vivi() {
    (cd "$repo_root" && zig build)
}

doctor() {
    require_command zig
    require_command vhs
    require_command script
    require_command copilot
    require_command ffmpeg
    require_command ffprobe
    build_vivi

    "$binary" --version
    zig version
    vhs --version
    copilot --version
    ffmpeg -version | sed -n '1p'

    auth_output=$(
        copilot \
            --silent \
            --no-custom-instructions \
            --disable-builtin-mcps \
            --no-ask-user \
            -p 'Reply with exactly VIVI_DOCTOR_OK.'
    )
    test "$auth_output" = "VIVI_DOCTOR_OK"
    printf 'doctor: ready\n'
}

cli_discovery() {
    run_dir=$(prepare_run "$1")
    build_vivi

    if "$binary" --help >"$run_dir/help.stdout" 2>"$run_dir/help.stderr"; then
        help_status=0
    else
        help_status=$?
    fi
    if "$binary" --version >"$run_dir/version.stdout" 2>"$run_dir/version.stderr"; then
        version_status=0
    else
        version_status=$?
    fi

    {
        printf 'help_exit=%s\n' "$help_status"
        printf 'version_exit=%s\n' "$version_status"
        printf 'help_contains_chat='
        if grep -q 'chat       Start an interactive streaming Vivi chat.' "$run_dir/help.stdout"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'help_contains_models='
        if grep -q 'models     List available Copilot and OMLX models.' "$run_dir/help.stdout"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/cli-discovery.assertions.txt"

    test "$help_status" -eq 0
    test "$version_status" -eq 0
    grep -q 'chat       Start an interactive streaming Vivi chat.' "$run_dir/help.stdout"
    grep -q 'models     List available Copilot and OMLX models.' "$run_dir/help.stdout"
    grep -q '^vivi ' "$run_dir/version.stdout"
}

validate_capture_name() {
    case "$1" in
        chat-streaming|chat-streaming-input|chat-markdown|chat-markdown-read|chat-ask-user|chat-model-menu|chat-customization|chat-session-resume|chat-shutdown) ;;
        *)
            printf 'capture must be chat-streaming, chat-streaming-input, chat-markdown, chat-markdown-read, chat-ask-user, chat-model-menu, chat-customization, chat-session-resume, or chat-shutdown\n' >&2
            exit 1
            ;;
    esac
}

extract_frames() {
    run_dir=$(prepare_run "$1")
    capture=$2
    validate_capture_name "$capture"
    gif="$run_dir/$capture.gif"
    frame_dir="$run_dir/$capture.frames"

    test -s "$gif" || {
        printf 'missing GIF: %s\n' "$gif" >&2
        exit 1
    }

    mkdir -p "$frame_dir"
    find "$frame_dir" -type f -name 'frame-*.png' -delete
    ffmpeg -loglevel error -y -i "$gif" -vf fps=1 \
        "$frame_dir/frame-%03d.png"
    ffmpeg -loglevel error -y -i "$gif" \
        -vf 'fps=1/2,scale=600:-1,tile=4x4' -frames:v 1 \
        "$run_dir/$capture.contact-sheet.png"

    frame_count=$(
        find "$frame_dir" -type f -name 'frame-*.png' | wc -l |
            tr -d ' '
    )
    ffprobe -v error -select_streams v:0 \
        -show_entries stream=width,height -show_entries format=duration \
        -of default=noprint_wrappers=1 "$gif" \
        >"$run_dir/$capture.frames.txt"
    printf 'extracted_frames=%s\n' "$frame_count" \
        >>"$run_dir/$capture.frames.txt"

    if ! test -f "$run_dir/$capture.visual-review.md"; then
        cat >"$run_dir/$capture.visual-review.md" <<EOF
# $capture visual review

status: pending

- [ ] The Vivi welcome or transcript role labels are readable and not clipped.
- [ ] The accented composer is intact and does not overlap the transcript.
- [ ] The typed user action is visible before or during submission.
- [ ] Transcript labels and content remain legible during redraws.
- [ ] The expected feature-specific state is visible in at least one frame.
- [ ] No frame shows stale text, severe flicker, broken borders, or layout corruption.

Reviewed artifacts:

- $capture.contact-sheet.png
- $capture.frames/frame-*.png

Notes:

- Replace this line with the inspected frame numbers and observations.
EOF
    fi

    test "$frame_count" -ge 3
    test -s "$run_dir/$capture.contact-sheet.png"
    if test "${VIVI_KEEP_GIF:-0}" != "1"; then
        rm -f "$gif"
    fi
}

frame_check() {
    run_dir=$(prepare_run "$1")
    capture=$2
    validate_capture_name "$capture"
    review="$run_dir/$capture.visual-review.md"
    metadata="$run_dir/$capture.frames.txt"

    test -s "$run_dir/$capture.contact-sheet.png"
    test -s "$metadata"
    test -s "$review"
    grep -q '^width=1200$' "$metadata"
    grep -q '^height=720$' "$metadata"
    frame_count=$(sed -n 's/^extracted_frames=//p' "$metadata")
    test "$frame_count" -ge 3
    grep -q '^status: pass$' "$review"
    if grep -q '^- \[ \]' "$review"; then
        printf 'visual review still has unchecked expectations: %s\n' "$review" >&2
        exit 1
    fi
    if grep -q '^- \[!\]' "$review"; then
        printf 'visual review records a failed expectation: %s\n' "$review" >&2
        exit 1
    fi
    assertions="$run_dir/$capture.assertions.txt"
    if test -f "$assertions" &&
        ! grep -q '^visual_review=pass$' "$assertions"
    then
        printf 'visual_review=pass\n' >>"$assertions"
    fi
}

write_streaming_tape() {
    run_dir=$1
    cat >"$run_dir/chat-streaming.tape" <<EOF
Output "$run_dir/chat-streaming.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 20ms

Type "./zig-out/bin/vivi chat"
Enter
Sleep 3s
Type "Return the uppercase spelling of vivi_stream_ok and nothing else."
Enter
Sleep 20s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_streaming() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_streaming_tape "$run_dir"

    (cd "$repo_root" && vhs "$run_dir/chat-streaming.tape")
    extract_frames "$1" chat-streaming

    (
        sleep 3
        printf 'Return the uppercase spelling of vivi_stream_ok and nothing else.\r'
        sleep 20
        printf '\003'
        sleep 3
        printf '\003'
    ) | script -q "$run_dir/chat-streaming.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-streaming.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-streaming.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'expected_response=VIVI_STREAM_OK\n'
        printf 'response_seen='
        if grep -q 'VIVI_STREAM_OK' "$run_dir/chat-streaming.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'frames_extracted='
        if test -s "$run_dir/chat-streaming.frames.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'contact_sheet_nonempty='
        if test -s "$run_dir/chat-streaming.contact-sheet.png"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'recording_retained='
        if test -s "$run_dir/chat-streaming.gif"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-streaming.assertions.txt"

    test "$status" -eq 0
    grep -q 'VIVI_STREAM_OK' "$run_dir/chat-streaming.normalized.txt"
    test -s "$run_dir/chat-streaming.frames.txt"
    test -s "$run_dir/chat-streaming.contact-sheet.png"
}

write_markdown_tape() {
    run_dir=$1
    cat >"$run_dir/chat-markdown.tape" <<EOF
Output "$run_dir/chat-markdown.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 10ms

Type "./zig-out/bin/vivi chat --model copilot/gpt-5.4"
Enter
Sleep 3s
Type "Convert these lowercase labels to uppercase in the response: render test, feature, status, styling, working, tables, readable, vivi_highlight. Use the converted first label as a Markdown heading, then one sentence with bold text and inline code, then a fenced zig code block containing const followed by the converted final label followed by = 42;, then a two-column table using the other converted labels. Do not use tools or add any other text."
Enter
Sleep 20s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_markdown() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_markdown_tape "$run_dir"

    (cd "$repo_root" && VIVI_KEEP_GIF=1 vhs "$run_dir/chat-markdown.tape")
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-markdown

    (
        sleep 3
        printf '%s\r' \
            'Convert these lowercase labels to uppercase in the response: render test, feature, status, styling, working, tables, readable, vivi_highlight. Use the converted first label as a Markdown heading, then one sentence with bold text and inline code, then a fenced zig code block containing const followed by the converted final label followed by = 42;, then a two-column table using the other converted labels. Do not use tools or add any other text.'
        sleep 20
        printf '\003'
        sleep 3
        printf '\003'
    ) | script -q "$run_dir/chat-markdown.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat --model copilot/gpt-5.4" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-markdown.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-markdown.normalized.txt"

    table_cells_seen=yes
    for marker in FEATURE STATUS STYLING WORKING TABLES READABLE; do
        if ! grep -q "$marker" "$run_dir/chat-markdown.normalized.txt"; then
            table_cells_seen=no
        fi
    done

    {
        printf 'exit=%s\n' "$status"
        printf 'heading_expected=RENDER TEST\n'
        printf 'heading_seen='
        if grep -q 'RENDER TEST' "$run_dir/chat-markdown.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'table_cells_expected=FEATURE,STATUS,STYLING,WORKING,TABLES,READABLE\n'
        printf 'table_cells_seen=%s\n' "$table_cells_seen"
        printf 'zig_code_seen='
        if grep -q 'VIVI_HIGHLIGHT = 42' "$run_dir/chat-markdown.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'frames_extracted='
        if test -s "$run_dir/chat-markdown.frames.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'contact_sheet_nonempty='
        if test -s "$run_dir/chat-markdown.contact-sheet.png"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-markdown.assertions.txt"

    test "$status" -eq 0
    grep -q 'RENDER TEST' "$run_dir/chat-markdown.normalized.txt"
    grep -q 'VIVI_HIGHLIGHT = 42' "$run_dir/chat-markdown.normalized.txt"
    test "$table_cells_seen" = yes
    test -s "$run_dir/chat-markdown.frames.txt"
    test -s "$run_dir/chat-markdown.contact-sheet.png"
}

write_markdown_read_tape() {
    run_dir=$1
    cat >"$run_dir/chat-markdown-read.tape" <<EOF
Output "$run_dir/chat-markdown-read.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 18
Set TypingSpeed 5ms

Type "./zig-out/bin/vivi chat --model copilot/gpt-5.4"
Enter
Sleep 3s
Type "Use the read tool exactly once to read README.md, then return the uppercase spelling of vivi_read_done and nothing else."
Enter
Sleep 20s
Type "\x1b[17~"
Sleep 1s
Enter
Sleep 5s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_markdown_read() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_markdown_read_tape "$run_dir"

    (cd "$repo_root" && VIVI_KEEP_GIF=1 vhs "$run_dir/chat-markdown-read.tape")
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-markdown-read

    (
        sleep 3
        printf '%s\r' \
            'Use the read tool exactly once to read README.md, then return the uppercase spelling of vivi_read_done and nothing else.'
        sleep 20
        printf '\033[17~'
        sleep 1
        printf '\r'
        sleep 5
        printf '\003'
        sleep 3
        printf '\003'
    ) | script -q "$run_dir/chat-markdown-read.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat --model copilot/gpt-5.4" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-markdown-read.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-markdown-read.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'read_tool_seen='
        grep -a -q 'Read README.md' "$run_dir/chat-markdown-read.terminal.log" &&
            printf 'yes\n' || printf 'no\n'
        printf 'heading_seen='
        grep -a -q 'Requirements' "$run_dir/chat-markdown-read.terminal.log" &&
            printf 'yes\n' || printf 'no\n'
        printf 'code_seen='
        grep -a -q 'zig build' "$run_dir/chat-markdown-read.terminal.log" &&
            printf 'yes\n' || printf 'no\n'
        printf 'response_seen='
        grep -q 'VIVI_READ_DONE' "$run_dir/chat-markdown-read.normalized.txt" &&
            printf 'yes\n' || printf 'no\n'
        printf 'frames_extracted='
        test -s "$run_dir/chat-markdown-read.frames.txt" &&
            printf 'yes\n' || printf 'no\n'
    } >"$run_dir/chat-markdown-read.assertions.txt"

    test "$status" -eq 0
    grep -a -q 'Read README.md' "$run_dir/chat-markdown-read.terminal.log"
    grep -a -q 'Requirements' "$run_dir/chat-markdown-read.terminal.log"
    grep -a -q 'zig build' "$run_dir/chat-markdown-read.terminal.log"
    grep -q 'VIVI_READ_DONE' "$run_dir/chat-markdown-read.normalized.txt"
    test -s "$run_dir/chat-markdown-read.frames.txt"
    test -s "$run_dir/chat-markdown-read.contact-sheet.png"
}

write_streaming_input_tape() {
    run_dir=$1
    cat >"$run_dir/chat-streaming-input.tape" <<EOF
Output "$run_dir/chat-streaming-input.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 10ms

Type "./zig-out/bin/vivi chat"
Enter
Sleep 3s
Type "Run bash with command sleep 6, then reply with ORIGINAL_STEER_RESPONSE."
Enter
Sleep 3s
Type "Ignore the original reply. Concatenate VIVI, _STEER, and _OK, then reply with only that text."
Enter
Sleep 35s
Type "Run bash with command sleep 6, then concatenate VIVI, _QUEUE, and _FIRST and reply with only that text."
Enter
Sleep 3s
Type "Concatenate VIVI, _QUEUE, and _OK, then reply with only that text."
Ctrl+Enter
Sleep 35s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_streaming_input() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_streaming_input_tape "$run_dir"

    (cd "$repo_root" && VIVI_KEEP_GIF=1 vhs "$run_dir/chat-streaming-input.tape")
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-streaming-input

    (
        sleep 3
        printf 'Run bash with command sleep 6, then reply with ORIGINAL_STEER_RESPONSE.\r'
        sleep 3
        printf 'Ignore the original reply. Concatenate VIVI, _STEER, and _OK, then reply with only that text.\r'
        sleep 35
        printf 'Run bash with command sleep 6, then concatenate VIVI, _QUEUE, and _FIRST and reply with only that text.\r'
        sleep 3
        printf 'Concatenate VIVI, _QUEUE, and _OK, then reply with only that text.\033[13;5u'
        sleep 35
        printf '\003'
        sleep 3
        printf '\003'
    ) | script -q "$run_dir/chat-streaming-input.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-streaming-input.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-streaming-input.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'steer_response_seen='
        if grep -q 'VIVI_STEER_OK' "$run_dir/chat-streaming-input.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'first_response_seen='
        if grep -q 'IVI_QUEUE_FIRST' "$run_dir/chat-streaming-input.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'queued_response_seen='
        if grep -q 'VIVI_QUEUE_OK' "$run_dir/chat-streaming-input.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'streaming_input_hint=visual-review\n'
    } >"$run_dir/chat-streaming-input.assertions.txt"

    test "$status" -eq 0
    grep -q 'VIVI_STEER_OK' "$run_dir/chat-streaming-input.normalized.txt"
    grep -q 'IVI_QUEUE_FIRST' "$run_dir/chat-streaming-input.normalized.txt"
    grep -q 'VIVI_QUEUE_OK' "$run_dir/chat-streaming-input.normalized.txt"
    test -s "$run_dir/chat-streaming-input.contact-sheet.png"
}

write_ask_user_tape() {
    run_dir=$1
    cat >"$run_dir/chat-ask-user.tape" <<EOF
Output "$run_dir/chat-ask-user.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 10ms

Type "./zig-out/bin/vivi chat --model copilot/default"
Enter
Sleep 10s
Type "Use ask_user to ask exactly Pick one with choices Alpha and Beta and no freeform. After I answer, reply exactly ANSWER followed by the answer."
Enter
Sleep 25s
Down
Sleep 2s
Enter
Sleep 25s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_ask_user() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_ask_user_tape "$run_dir"

    (cd "$repo_root" && VIVI_KEEP_GIF=1 vhs "$run_dir/chat-ask-user.tape")
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-ask-user

    (
        sleep 10
        printf 'Use ask_user to ask exactly Pick one with choices Alpha and Beta and no freeform. After I answer, reply exactly ANSWER followed by the answer.\r'
        sleep 25
        printf '\033[B'
        sleep 2
        printf '\r'
        sleep 25
        printf '\003'
        sleep 3
        printf '\003'
    ) | script -q "$run_dir/chat-ask-user.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat --model copilot/default" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-ask-user.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-ask-user.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'question_seen='
        if grep -q 'Pick one' "$run_dir/chat-ask-user.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'choices_seen='
        if grep -q 'Alpha' "$run_dir/chat-ask-user.normalized.txt" &&
            grep -q 'Beta' "$run_dir/chat-ask-user.normalized.txt"
        then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'question_panel_seen='
        if grep -q 'Answer required' "$run_dir/chat-ask-user.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'answer_seen='
        if grep -Eq 'Vivi[[:space:]]*ANSWER[[:space:]]*Beta' \
            "$run_dir/chat-ask-user.normalized.txt"
        then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-ask-user.assertions.txt"

    test "$status" -eq 0
    grep -q 'Pick one' "$run_dir/chat-ask-user.normalized.txt"
    grep -q 'Alpha' "$run_dir/chat-ask-user.normalized.txt"
    grep -q 'Beta' "$run_dir/chat-ask-user.normalized.txt"
    grep -q 'Answer required' "$run_dir/chat-ask-user.normalized.txt"
    grep -Eq 'Vivi[[:space:]]*ANSWER[[:space:]]*Beta' \
        "$run_dir/chat-ask-user.normalized.txt"
    test -s "$run_dir/chat-ask-user.contact-sheet.png"
}

write_model_menu_tape() {
    run_dir=$1
    startup_wait=${VIVI_MODEL_MENU_STARTUP_WAIT:-60s}
    cat >"$run_dir/chat-model-menu.tape" <<EOF
Output "$run_dir/chat-model-menu.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 20ms

Type "./zig-out/bin/vivi chat"
Enter
Sleep $startup_wait
Type "/model"
Sleep 3s
Enter
Sleep 5s
Type "gpt-5.6-sol"
Sleep 2s
Enter
Sleep 10s
Type "Return the uppercase spelling of vivi_hosted_model_switch_ok and nothing else."
Enter
Sleep 30s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

chat_model_menu() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_model_menu_tape "$run_dir"
    settings_home="$run_dir/home"
    mkdir -p "$settings_home"
    rm -f "$settings_home/.vivi/settings.json"
    if test -n "${HOME:-}" &&
        test -d "$HOME/.copilot" &&
        ! test -e "$settings_home/.copilot"
    then
        ln -s "$HOME/.copilot" "$settings_home/.copilot"
    fi

    (
        cd "$repo_root" &&
            HOME="$settings_home" VIVI_KEEP_GIF=1 \
                vhs "$run_dir/chat-model-menu.tape"
    )
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-model-menu

    (
        sleep 4
        printf '/model'
        sleep 3
        printf '\r'
        sleep 5
        printf 'gpt-5.6-sol'
        sleep 2
        printf '\r'
        sleep 10
        printf 'Return the uppercase spelling of vivi_hosted_model_switch_ok and nothing else.\r'
        sleep 30
        printf '\003'
        sleep 3
        printf '\003'
    ) | HOME="$settings_home" \
        script -q "$run_dir/chat-model-menu.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-model-menu.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-model-menu.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'persisted_default_seen='
        if grep -q 'Already using the selected model.' "$run_dir/chat-model-menu.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'response_seen='
        if grep -q 'VIVI_HOSTED_MODEL_SWITCH_OK' "$run_dir/chat-model-menu.normalized.txt"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-model-menu.assertions.txt"

    test "$status" -eq 0
    grep -q 'Already using the selected model.' "$run_dir/chat-model-menu.normalized.txt"
    grep -q 'VIVI_HOSTED_MODEL_SWITCH_OK' "$run_dir/chat-model-menu.normalized.txt"
    grep -q '"default_model": "copilot/gpt-5.6-sol"' \
        "$settings_home/.vivi/settings.json"
    test -s "$run_dir/chat-model-menu.contact-sheet.png"
}

write_customization_tape() {
    run_dir=$1
    workspace=$2
    startup_wait=${VIVI_CUSTOMIZATION_STARTUP_WAIT:-60s}
    cat >"$run_dir/chat-customization.tape" <<EOF
Output "$run_dir/chat-customization.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 20ms

Type "cd '$workspace' && '$binary' chat --model copilot/default"
Enter
Sleep $startup_wait
Type "probe"
Enter
Sleep 25s
Type "/vivi-fixture"
Sleep 5s
Enter
Sleep 25s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 1s
EOF
}

prepare_customization_workspace() {
    workspace=$1
    rm -rf "$workspace"
    mkdir -p "$workspace/.agents/skills/vivi-fixture"
    cat >"$workspace/AGENTS.md" <<'EOF'
When the user sends exactly "probe", do not use tools and reply with exactly VIVI_INSTRUCTION_OK.
EOF
    cat >"$workspace/.agents/skills/vivi-fixture/SKILL.md" <<'EOF'
---
name: vivi-fixture
description: Fixture skill discovered by Vivi.
user-invocable: true
---

When invoked, return the uppercase spelling of vivi_skill_ok and nothing else.
EOF
}

chat_customization() {
    run_dir=$(prepare_run "$1")
    build_vivi
    workspace="$run_dir/workspace"
    customization_home="$run_dir/home"
    prepare_customization_workspace "$workspace"
    write_customization_tape "$run_dir" "$workspace"
    mkdir -p "$customization_home"
    rm -rf "$customization_home/.vivi"
    if test -n "${HOME:-}" &&
        test -d "$HOME/.copilot" &&
        ! test -e "$customization_home/.copilot"
    then
        ln -s "$HOME/.copilot" "$customization_home/.copilot"
    fi

    HOME="$customization_home" VIVI_KEEP_GIF=1 \
        vhs "$run_dir/chat-customization.tape"
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-customization

    (
        sleep 60
        printf 'probe\r'
        sleep 25
        printf '/vivi-fixture'
        sleep 5
        printf '\r'
        sleep 25
        printf '\003'
        sleep 3
        printf '\003'
    ) | HOME="$customization_home" \
        script -q "$run_dir/chat-customization.terminal.log" sh -c \
        "cd '$workspace' && stty cols 100 rows 30; '$binary' chat --model copilot/default" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-customization.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-customization.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'instruction_seen='
        grep -q 'VIVI_INSTRUCTION_OK' "$run_dir/chat-customization.normalized.txt" &&
            printf 'yes\n' || printf 'no\n'
        printf 'skill_menu_seen='
        grep -q 'Fixture skill discovered by Vivi.' \
            "$run_dir/chat-customization.normalized.txt" &&
            printf 'yes\n' || printf 'no\n'
        printf 'skill_response_seen='
        grep -q 'VIVI_SKILL_OK' "$run_dir/chat-customization.normalized.txt" &&
            printf 'yes\n' || printf 'no\n'
    } >"$run_dir/chat-customization.assertions.txt"

    test "$status" -eq 0
    grep -q 'VIVI_INSTRUCTION_OK' "$run_dir/chat-customization.normalized.txt"
    grep -q 'Fixture skill discovered by Vivi.' \
        "$run_dir/chat-customization.normalized.txt"
    grep -q 'VIVI_SKILL_OK' "$run_dir/chat-customization.normalized.txt"
    test -s "$run_dir/chat-customization.contact-sheet.png"
}

write_session_resume_tape() {
    run_dir=$1
    cat >"$run_dir/chat-session-resume.tape" <<EOF
Output "$run_dir/chat-session-resume.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22
Set TypingSpeed 20ms

Type "./zig-out/bin/vivi chat --model copilot/default"
Enter
Sleep 10s
Type "Remember the token VIVI_RESUME_MEMORY for this session. Reply exactly SAVED."
Enter
Sleep 25s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 2s
Type "./zig-out/bin/vivi chat --model copilot/default"
Enter
Sleep 10s
Type "/resume"
Sleep 10s
Enter
Sleep 5s
Enter
Sleep 8s
Type "Reply with only the token I asked you to remember earlier."
Enter
Sleep 25s
Ctrl+C
Sleep 3s
Ctrl+C
Sleep 2s
EOF
}

chat_session_resume() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_session_resume_tape "$run_dir"
    resume_home="$run_dir/home"
    vhs_home="$run_dir/vhs-home"
    mkdir -p "$resume_home"
    mkdir -p "$vhs_home"
    rm -rf "$resume_home/.vivi"
    rm -rf "$vhs_home/.vivi"
    if test -n "${HOME:-}" &&
        test -d "$HOME/.copilot" &&
        ! test -e "$resume_home/.copilot"
    then
        ln -s "$HOME/.copilot" "$resume_home/.copilot"
    fi
    if test -n "${HOME:-}" &&
        test -d "$HOME/.copilot" &&
        ! test -e "$vhs_home/.copilot"
    then
        ln -s "$HOME/.copilot" "$vhs_home/.copilot"
    fi

    (
        cd "$repo_root" &&
            HOME="$vhs_home" VIVI_KEEP_GIF=1 \
                vhs "$run_dir/chat-session-resume.tape"
    )
    VIVI_KEEP_GIF=1 extract_frames "$1" chat-session-resume

    (
        sleep 10
        printf 'Remember the token VIVI_RESUME_MEMORY for this session. Reply exactly SAVED.\r'
        sleep 25
        printf '\003'
        sleep 3
        printf '\003'
        sleep 2
    ) | HOME="$resume_home" \
        script -q "$run_dir/chat-session-resume-first.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat --model copilot/default"

    (
        sleep 10
        printf '/resume'
        sleep 10
        printf '\r'
        sleep 5
        printf '\r'
        sleep 8
        printf 'Reply with only the token I asked you to remember earlier.\r'
        sleep 25
        printf '\003'
        sleep 3
        printf '\003'
        sleep 2
    ) | HOME="$resume_home" \
        script -q "$run_dir/chat-session-resume-second.terminal.log" sh -c \
        "stty cols 100 rows 30; '$binary' chat --model copilot/default" &
    pty_pid=$!
    printf '%s\n' "$pty_pid" >"$run_dir/pty.pid"
    trap 'kill "$pty_pid" 2>/dev/null || true; wait "$pty_pid" 2>/dev/null || true' EXIT INT TERM

    if wait "$pty_pid"; then
        status=0
    else
        status=$?
    fi
    rm -f "$run_dir/pty.pid"
    trap - EXIT INT TERM
    cat "$run_dir/chat-session-resume-first.terminal.log" \
        "$run_dir/chat-session-resume-second.terminal.log" \
        >"$run_dir/chat-session-resume.terminal.log"

    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-session-resume.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-session-resume.normalized.txt"
    perl -0pe \
        's/\e\[[0-?]*[ -\/]*[@-~]//g; s/\e\][^\a]*(?:\a|\e\\)//g' \
        "$run_dir/chat-session-resume-second.terminal.log" |
        tr -d '\r\b' >"$run_dir/chat-session-resume-second.normalized.txt"

    {
        printf 'exit=%s\n' "$status"
        printf 'resume_status_seen='
        if grep -q 'Resumed ' \
            "$run_dir/chat-session-resume-second.normalized.txt"
        then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
        printf 'history_seen='
        if grep -Eq 'Vivi[[:space:]]*VIVI_RESUME_MEMORY' \
            "$run_dir/chat-session-resume-second.normalized.txt"
        then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-session-resume.assertions.txt"

    test "$status" -eq 0
    grep -q 'Resumed ' "$run_dir/chat-session-resume-second.normalized.txt"
    grep -Eq 'Vivi[[:space:]]*VIVI_RESUME_MEMORY' \
        "$run_dir/chat-session-resume-second.normalized.txt"
    test -s "$run_dir/chat-session-resume.contact-sheet.png"
}

write_shutdown_tape() {
    run_dir=$1
    cat >"$run_dir/chat-shutdown.tape" <<EOF
Output "$run_dir/chat-shutdown.gif"
Require copilot
Set Shell "bash"
Set Width 1200
Set Height 720
Set FontSize 22

Type "./zig-out/bin/vivi chat"
Enter
Sleep 3s
Ctrl+C
Sleep 3s
EOF
}

chat_shutdown() {
    run_dir=$(prepare_run "$1")
    build_vivi
    write_shutdown_tape "$run_dir"
    (cd "$repo_root" && vhs "$run_dir/chat-shutdown.tape")
    extract_frames "$1" chat-shutdown
    test -s "$run_dir/chat-shutdown.frames.txt"
    test -s "$run_dir/chat-shutdown.contact-sheet.png"
    printf 'frames_extracted=yes\ncontact_sheet_nonempty=yes\nshutdown=ctrl-c\n' \
        >"$run_dir/chat-shutdown.assertions.txt"
}

cleanup() {
    run_dir=$(prepare_run "$1")
    if test -f "$run_dir/pty.pid"; then
        pid=$(cat "$run_dir/pty.pid")
        case "$pid" in
            ""|*[!0-9]*) ;;
            *)
                kill "$pid" 2>/dev/null || true
                wait "$pid" 2>/dev/null || true
                ;;
        esac
        rm -f "$run_dir/pty.pid"
    fi
    find "$run_dir" -type f -name '*.tape' -size 0 -delete
}

case "${1:-}" in
    doctor)
        test "$#" -eq 1 || {
            usage >&2
            exit 2
        }
        doctor
        ;;
    cli-discovery)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        cli_discovery "$2"
        ;;
    chat-streaming)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_streaming "$2"
        ;;
    chat-streaming-input)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_streaming_input "$2"
        ;;
    chat-markdown)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_markdown "$2"
        ;;
    chat-markdown-read)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_markdown_read "$2"
        ;;
    chat-ask-user)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_ask_user "$2"
        ;;
    chat-model-menu)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_model_menu "$2"
        ;;
    chat-customization)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_customization "$2"
        ;;
    chat-session-resume)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_session_resume "$2"
        ;;
    chat-shutdown)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        chat_shutdown "$2"
        ;;
    extract-frames)
        test "$#" -eq 3 || {
            usage >&2
            exit 2
        }
        extract_frames "$2" "$3"
        ;;
    frame-check)
        test "$#" -eq 3 || {
            usage >&2
            exit 2
        }
        frame_check "$2" "$3"
        ;;
    cleanup)
        test "$#" -eq 2 || {
            usage >&2
            exit 2
        }
        cleanup "$2"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
