#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
artifact_root="$repo_root/.verify/vivi"
binary="$repo_root/dist/vivi"
default_validation_model=gpt-6-luna

usage() {
    cat <<'EOF'
Usage:
  verify-vivi doctor
  verify-vivi cli-discovery <run-id>
  verify-vivi chat-streaming <run-id>
EOF
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'missing required command: %s\n' "$1" >&2
        exit 1
    }
}

validate_run_id() {
    case "${1:-}" in
        ""|*[!A-Za-z0-9._-]*)
            printf 'run-id must use only letters, digits, dots, underscores, or hyphens\n' >&2
            exit 1
            ;;
    esac
}

validation_model() {
    model=${VIVI_VALIDATION_MODEL:-$default_validation_model}
    case "$model" in
        ""|copilot/*)
            printf 'VIVI_VALIDATION_MODEL must use a native Copilot model ID: %s\n' "$model" >&2
            exit 2
            ;;
        *) printf '%s\n' "$model" ;;
    esac
}

prepare_run() {
    validate_run_id "$1"
    run_dir="$artifact_root/$1"
    mkdir -p "$run_dir"
    printf '%s\n' "$run_dir"
}

build_vivi() {
    (cd "$repo_root" && bun run build >/dev/null)
}

auth_token() {
    gh auth token
}

doctor() {
    require_command bun
    require_command copilot
    require_command gh
    build_vivi

    token=$(auth_token)
    model=$(validation_model)
    home=$(mktemp -d "${TMPDIR:-/tmp}/vivi-doctor.XXXXXX")
    cleanup() {
        rm -rf "$home"
    }
    trap cleanup EXIT INT TERM

    "$binary" --version
    bun --version
    copilot --version

    output=$(
        GH_TOKEN="$token" \
        GITHUB_TOKEN="$token" \
        VIVI_HOME="$home" \
        "$binary" \
            --silent \
            --no-ask-user \
            --disable-builtin-mcps \
            --model "$model" \
            -p 'Reply with exactly VIVI_DOCTOR_OK.'
    )
    test "$output" = "VIVI_DOCTOR_OK"
    test -f "$home/copilot/extensions/vivi-system-prompt/extension.mjs"
    test -f "$home/copilot/extensions/vivi-reasoning/extension.mjs"
    test -f "$home/copilot/extensions/vivi-selection-persistence/extension.mjs"
    test -f "$home/settings.json"
    printf 'doctor: ready\n'
}

cli_discovery() {
    require_command copilot
    run_dir=$(prepare_run "$1")
    build_vivi
    home=$(mktemp -d "${TMPDIR:-/tmp}/vivi-cli-discovery.XXXXXX")
    cleanup() {
        rm -rf "$home"
    }
    trap cleanup EXIT INT TERM

    "$binary" --help >"$run_dir/help.stdout" 2>"$run_dir/help.stderr"
    "$binary" --version >"$run_dir/version.stdout" 2>"$run_dir/version.stderr"
    "$binary" models >"$run_dir/models.stdout" 2>"$run_dir/models.stderr"
    VIVI_HOME="$home/vivi" "$binary" --no-auto-update help environment \
        >"$run_dir/native-help.stdout" 2>"$run_dir/native-help.stderr"
    COPILOT_HOME="$home/copilot" copilot --no-auto-update help environment \
        >"$run_dir/copilot-help.stdout" 2>"$run_dir/copilot-help.stderr"

    {
        printf 'help_exit=0\n'
        printf 'version_exit=0\n'
        printf 'models_exit=0\n'
        printf 'native_help_exit=0\n'
        printf 'copilot_help_exit=0\n'
        printf 'help_contains_models='
        grep -q 'models     List discovered local provider models.' "$run_dir/help.stdout" &&
            printf 'yes\n' || printf 'no\n'
        printf 'native_args_forwarded='
        if cmp -s "$run_dir/native-help.stdout" "$run_dir/copilot-help.stdout" &&
            cmp -s "$run_dir/native-help.stderr" "$run_dir/copilot-help.stderr"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/cli-discovery.assertions.txt"

    grep -q '^vivi ' "$run_dir/version.stdout"
    grep -q 'models     List discovered local provider models.' "$run_dir/help.stdout"
    grep -q 'COPILOT_ALLOW_ALL' "$run_dir/native-help.stdout"
    cmp "$run_dir/native-help.stdout" "$run_dir/copilot-help.stdout"
    cmp "$run_dir/native-help.stderr" "$run_dir/copilot-help.stderr"
    cleanup
    trap - EXIT INT TERM
}

chat_streaming() {
    require_command script
    run_dir=$(prepare_run "$1")
    build_vivi

    token=$(auth_token)
    model=$(validation_model)
    home="$run_dir/home"
    mkdir -p "$home"
    cleanup() {
        rm -rf "$home"
    }
    trap cleanup EXIT INT TERM

    if script -q "$run_dir/chat-streaming.terminal.log" \
        env \
            GH_TOKEN="$token" \
            GITHUB_TOKEN="$token" \
            VIVI_HOME="$home" \
            "$binary" \
                --no-color \
                --model "$model" \
                -p 'Return the uppercase form of vivi_stream_ok and no other text.' \
        >"$run_dir/chat-streaming.stdout" \
        2>"$run_dir/chat-streaming.stderr"; then
        status=0
    else
        status=$?
    fi

    {
        printf 'exit=%s\n' "$status"
        printf 'response_marker='
        grep -a -q 'VIVI_STREAM_OK' "$run_dir/chat-streaming.terminal.log" &&
            printf 'yes\n' || printf 'no\n'
        printf 'extensions_materialized='
        if test -f "$home/copilot/extensions/vivi-system-prompt/extension.mjs" &&
            test -f "$home/copilot/extensions/vivi-reasoning/extension.mjs" &&
            test -f "$home/copilot/extensions/vivi-selection-persistence/extension.mjs"; then
            printf 'yes\n'
        else
            printf 'no\n'
        fi
    } >"$run_dir/chat-streaming.assertions.txt"

    grep -a -q 'VIVI_STREAM_OK' "$run_dir/chat-streaming.terminal.log"
    test "$status" -eq 0
    test -f "$home/copilot/extensions/vivi-system-prompt/extension.mjs"
    test -f "$home/copilot/extensions/vivi-reasoning/extension.mjs"
    test -f "$home/copilot/extensions/vivi-selection-persistence/extension.mjs"
    cleanup
    trap - EXIT INT TERM
}

case "${1:-}" in
    doctor)
        test "$#" -eq 1 || { usage >&2; exit 1; }
        doctor
        ;;
    cli-discovery)
        test "$#" -eq 2 || { usage >&2; exit 1; }
        cli_discovery "$2"
        ;;
    chat-streaming)
        test "$#" -eq 2 || { usage >&2; exit 1; }
        chat_streaming "$2"
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
