{
  "name": "vivi-typescript-rewrite",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "boundary-check": "bun scripts/check-boundaries.ts",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "test": "bun test",
    "probe:runtime": "bun scripts/runtime-probe.ts",
    "build:vivi": "bun build apps/vivi/src/main.ts --compile --outfile apps/vivi/dist/vivi",
    "verify:compiled-parity": "bun scripts/verify-compiled-parity.ts",
    "check": "bun run boundary-check && bun run typecheck && bun run test && bun run build:vivi"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.14",
    "@opentui/core": "0.5.11",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
