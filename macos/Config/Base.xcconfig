MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0

VIVI_REPOSITORY_ROOT = $(SRCROOT)/..
VIVI_BACKEND_INCLUDE_DIR = $(VIVI_REPOSITORY_ROOT)/backend/include
VIVI_BACKEND_LIBRARY = $(BUILT_PRODUCTS_DIR)/libvivi_backend.a

HEADER_SEARCH_PATHS = $(inherited) "$(VIVI_BACKEND_INCLUDE_DIR)"
SWIFT_INCLUDE_PATHS = $(inherited) "$(VIVI_BACKEND_INCLUDE_DIR)"
OTHER_LDFLAGS = $(inherited) "$(VIVI_BACKEND_LIBRARY)"
